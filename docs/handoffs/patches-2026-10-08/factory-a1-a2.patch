 source "${0:A:h}/destructive-filter.sh"
+source "${0:A:h}/owner-approval.sh"
 
 while true; do
   for pr in $(gh pr list --state open --author sm33xy --json number,isDraft --jq '.[] | select(.isDraft==false) | .number' 2>/dev/null); do
@@ -30,6 +33,10 @@
