# Generated by the toolchain on every build and typecheck, never hand-edited.
# Tracked until P2-16, which meant every build dirtied the working tree of every
# session in this repository and each one had to run git checkout -- on them
# before staging. That reflex is the danger: applied to a file that was
# genuinely edited, it discards real work.
# Both stay ON DISK. Next regenerates next-env.d.ts on the next build, and
# losing tsconfig.tsbuildinfo costs one slow typecheck and nothing else.
tsconfig.tsbuildinfo
next-env.d.ts

# P2-11: dosarul de build folosit de serverul de productie din suita.
.next-prod

# P3-71: dosarul de build folosit de serverul fara MAKE_WEBHOOK_URL din suita.
.next-no-webhook

# P3-95: dosarul de build folosit de serverul PRINCIPAL al suitei, care ruleaza
# un build de productie de cand serverul de dezvoltare se repornea singur la
# pragul lui de memorie si lua cu el testul aflat in zbor.
.next-main

# P3-117: urmele pasului de baseline din CI. Jurnalul serverului pornit pentru
# masurare, iesirea rularii din care se citesc cele sase numere si numararea
# liniilor de raport. Exista numai pe runner, cat tine un job.
perf-server.log
perf-server.pid
perf-run.log
perf-count.txt

# P3-120: memoria locala a unui hook de unealta al masinii pe care ruleaza
# sesiunea, nu sursa. Se rescrie la fiecare editare de fisier si nu descrie nimic
# despre acest proiect. A ajuns urmarita printr-un `git add -A` pe 2026-10-01 si
# este scoasa in acelasi card, din acelasi motiv pentru care P3-05b a scos starea
# CLI-ului Supabase: o unealta locala nu are ce sa caute intr-un pull request.
.impeccable/

# Stare locala a CLI-ului Supabase, nu sursa. .branches/_current_branch si
# .temp/cli-latest sunt scrise de `supabase start` si `supabase db reset` pe
# masina fiecaruia si nu descriu nimic despre proiect. Au ajuns urmarite pe
# 2026-09-01 printr-un `git add -A` din cardul P3-04b si sunt scoase de P3-05b.
supabase/.branches/
supabase/.temp/
